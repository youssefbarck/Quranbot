# توكن البوت من BotFather
TELEGRAM_BOT_TOKEN=ضع_التوكن_هنا

# رابط قاعدة بيانات Neon (Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# معرف المستخدم الرئيسي (راسل @userinfobot للحصول عليه)
ADMIN_TELEGRAM_ID=123456789

# أوقات التذكير الثلاثة (24 ساعة)
MORNING_TIME=08:00
MIDDAY_TIME=13:00
EVENING_TIME=20:00

# المنطقة الزمنية الافتراضية
DEFAULT_TIMEZONE=Africa/Algiers

# منفذ خادم keep-alive (Render يحدده تلقائياً)
PORT=10000

# keep-alive مدمج
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL=280
# RENDER_EXTERNAL_URL يُحقنه Render تلقائياً
RENDER_EXTERNAL_URL=
