# ===== إعدادات بوت تلغرام — طريقة الحصون الخمسة لحفظ القرآن =====

# توكن البوت من BotFather في تلغرام
TELEGRAM_BOT_TOKEN=ضع_التوكن_هنا

# رابط قاعدة بيانات Neon (Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# معرف المستخدم الرئيسي (Telegram ID)
# للحصول على معرفك: راسل بوت @userinfobot
ADMIN_TELEGRAM_ID=123456789

# أوقات التذكير الثلاثة (24 ساعة)
# 08:00 — الصباح: تذكير بقراءة حزبين
MORNING_TIME=08:00
# 13:00 — منتصف النهار: تذكير بالاستماع لحزب
MIDDAY_TIME=13:00
# 20:00 — المساء: سؤال تفاعلي (هل أنهيت الحفظ اليوم؟)
EVENING_TIME=20:00

# المنطقة الزمنية الافتراضية
DEFAULT_TIMEZONE=Africa/Algiers

# منفذ الويب هوك (Render يحدده تلقائياً)
PORT=10000
